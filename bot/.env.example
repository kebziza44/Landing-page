# ============================================================
# ADMIRE L.C. — Qabul tizimi konfiguratsiyasi
# Bu faylni ".env" deb nusxalang va qiymatlarni to'ldiring.
# HECH QACHON haqiqiy kalitlarni Git'ga yuklamang!
# ============================================================

# --- Telegram bot ---
# @BotFather'da yarating: /newbot -> tokenni shu yerga qo'ying
TELEGRAM_BOT_TOKEN=

# Bot username (BotFather bergan, masalan: admire_lc_bot — @siz)
# Saytdagi "Telegram orqali qabulga yozilish" tugmasi shuni ishlatadi.
TELEGRAM_BOT_USERNAME=

# Arizalar yuboriladigan admin chat: shaxsiy ID yoki PRIVATE guruh ID
# (guruh ID manfiy son bo'ladi, masalan: -1001234567890)
TELEGRAM_ADMIN_CHAT_ID=

# Admin panel / admin amallari uchun ruxsat etilgan Telegram user ID'lar
# (vergul bilan, masalan: 123456789,987654321)
TELEGRAM_ADMIN_IDS=

# --- Admin panel ---
# Admin panel login paroli (kuchli parol tanlang!)
ADMIN_PASSWORD=

# --- Server ---
PORT=3000
# public HTTPS URL (production webhook uchun), masalan https://admire.uz
BASE_URL=
# Telegram webhook secret (har qanday tasodifiy uzun satr)
WEBHOOK_SECRET=
# Bo'sh bo'lsa bot long-polling ishlatadi (development uchun qulay)

# --- Database ---
# Bo'sh: lokal SQLite fayl (bot/data/admire.db).
# Render Free'da persistent disk yo'q — u yerda tashqi PostgreSQL bering
# (Neon free tavsiya: https://neon.tech), masalan:
#   DATABASE_URL=postgresql://user:pass@ep-x.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
